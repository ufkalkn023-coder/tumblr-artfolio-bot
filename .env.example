# Tumblr API Kimlik Bilgileri (OAuth 1.0a)
TUMBLR_CONSUMER_KEY=your_consumer_key_here
TUMBLR_CONSUMER_SECRET=your_consumer_secret_here
TUMBLR_OAUTH_TOKEN=your_oauth_token_here
TUMBLR_OAUTH_SECRET=your_oauth_token_secret_here
TUMBLR_BLOG_NAME=artfolio-db.tumblr.com

# Rijksmuseum API (Opsiyonel)
RIJKSMUSEUM_API_KEY=your_rijksmuseum_api_key_here

# Minimum artwork quality score (0-100)
MINIMUM_QUALITY_SCORE=80

# Publication reservation timeout
PUBLICATION_RESERVATION_TTL_MINUTES=120

# Source circuit breaker
SOURCE_CIRCUIT_FAILURE_THRESHOLD=3
SOURCE_CIRCUIT_COOLDOWN_SECONDS=300

# Feed diversity (successful publication counts, not elapsed time)
ARTIST_COOLDOWN_POSTS=12
SOURCE_MAX_CONSECUTIVE_POSTS=3
MEDIUM_MAX_CONSECUTIVE_POSTS=3
